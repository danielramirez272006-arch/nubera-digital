generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums validados entre API, lógica de negocio y MySQL
// ============================================================================

enum EmployeeRole {
  colaborador
  rrhh
}

enum EmployeeStatus {
  activo
  baja
}

enum LeaveRequestType {
  vacaciones
  permiso_con_goce
  permiso_sin_goce
  incapacidad
  home_office
}

enum LeaveRequestStatus {
  pendiente
  aprobada
  rechazada
  cancelada
}

enum DisabilityType {
  enfermedad_general
  maternidad
  riesgo_trabajo
}

enum DisabilityStatus {
  activa
  concluida
}

enum DocumentStatus {
  activo
  eliminado
}

enum AlertStatus {
  activa
  revisada
  resuelta
}

enum ChatOutcome {
  resuelta
  escalada_rrhh
  denegada
  error
}

enum TicketStatus {
  abierto
  en_proceso
  resuelto
  cerrado
}

// ============================================================================
// Modelos principales (conservan tablas, IDs y tipos existentes en MySQL)
// ============================================================================

model Employee {
  id              Int            @id @default(autoincrement())
  employeeCode    String         @unique @map("employee_code") @db.VarChar(20)
  email           String         @unique @db.VarChar(120)
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  fullName        String         @map("full_name") @db.VarChar(150)
  role            EmployeeRole
  department      String         @db.VarChar(80)
  position        String         @db.VarChar(100)
  hireDate        DateTime       @map("hire_date") @db.Date
  terminationDate DateTime?      @map("termination_date") @db.Date
  status          EmployeeStatus @default(activo)
  salaryMxn       Decimal        @default(0.00) @map("salary_mxn") @db.Decimal(12, 2)
  managerName     String?        @map("manager_name") @db.VarChar(150)
  nextPaymentDate DateTime?      @map("next_payment_date") @db.Date
  nextReviewDate  DateTime?      @map("next_review_date") @db.Date
  createdAt       DateTime?      @default(now()) @map("created_at") @db.DateTime(0)

  // Relaciones
  // Decisión de conservación: los colaboradores se dan de baja lógica (status = 'baja');
  // sus registros históricos tienen Cascade en BD heredada, mientras aprobadores/asignados usan SetNull.
  balances          Balance[]
  leaveRequests     LeaveRequest[]     @relation("EmployeeRequests")
  approvedRequests  LeaveRequest[]     @relation("ApproverRequests")
  disabilities      Disability[]
  movements         Movement[]
  conversations     ChatConversation[]
  chatLogs          ChatLog[]
  tickets           Ticket[]           @relation("EmployeeTickets")
  assignedTickets   Ticket[]           @relation("AssigneeTickets")

  @@index([department, status], map: "idx_employees_dept_status")
  @@map("employees")
}

model Balance {
  id             Int       @id @default(autoincrement())
  employeeId     Int       @map("employee_id")
  year           Int
  entitledDays   Decimal   @map("entitled_days") @db.Decimal(6, 2)
  usedDays       Decimal   @default(0.00) @map("used_days") @db.Decimal(6, 2)
  pendingDays    Decimal   @default(0.00) @map("pending_days") @db.Decimal(6, 2)
  availableDays  Decimal   @map("available_days") @db.Decimal(6, 2)
  expirationDate DateTime  @map("expiration_date") @db.Date
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year], map: "uq_balance_emp_year")
  @@index([availableDays], map: "idx_balances_available")
  @@map("balances")
}

model LeaveRequest {
  id            Int                @id @default(autoincrement())
  employeeId    Int                @map("employee_id")
  approverId    Int?               @map("approver_id")
  requestType   LeaveRequestType   @map("request_type")
  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime           @map("end_date") @db.Date
  daysCount     Decimal            @map("days_count") @db.Decimal(5, 2)
  status        LeaveRequestStatus @default(pendiente)
  reason        String?            @db.Text
  approverNotes String?            @map("approver_notes") @db.Text
  createdAt     DateTime?          @default(now()) @map("created_at") @db.DateTime(0)
  resolvedAt    DateTime?          @map("resolved_at") @db.DateTime(0)

  employee Employee  @relation("EmployeeRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver Employee? @relation("ApproverRequests", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([employeeId, status], map: "idx_lr_emp_status")
  @@index([status, startDate, endDate], map: "idx_lr_status_dates")
  @@map("leave_requests")
}

model Disability {
  id             Int              @id @default(autoincrement())
  employeeId     Int              @map("employee_id")
  folioImss      String           @map("folio_imss") @db.VarChar(40)
  disabilityType DisabilityType   @map("disability_type")
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime         @map("end_date") @db.Date
  daysCount      Int              @map("days_count")
  status         DisabilityStatus @default(activa)
  createdAt      DateTime?        @default(now()) @map("created_at") @db.DateTime(0)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status], map: "idx_disabilities_emp_status")
  @@map("disabilities")
}

model Movement {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  movementType String    @map("movement_type") @db.VarChar(40)
  movementDate DateTime  @map("movement_date") @db.Date
  daysDelta    Decimal   @default(0.00) @map("days_delta") @db.Decimal(6, 2)
  description  String    @db.Text
  createdAt    DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, movementDate], map: "idx_movements_emp_date")
  @@map("movements")
}

model DriveDocument {
  id           Int            @id @default(autoincrement())
  driveFileId  String         @unique @map("drive_file_id") @db.VarChar(128)
  policyCode   String         @map("policy_code") @db.VarChar(30)
  title        String         @db.VarChar(200)
  mimeType     String         @map("mime_type") @db.VarChar(120)
  version      String         @db.VarChar(40)
  effectiveDate String        @default("2026-01-01") @map("effective_date") @db.VarChar(40)
  owner        String         @default("Dirección de Talento y Cultura") @db.VarChar(120)
  driveUrl     String         @map("drive_url") @db.Text
  contentHash  String         @map("content_hash") @db.VarChar(64)
  status       DocumentStatus @default(activo)
  lastSyncedAt DateTime?      @default(now()) @map("last_synced_at") @db.DateTime(0)

  chunks DocumentChunk[]

  @@index([policyCode, status], map: "idx_drive_docs_policy_status")
  @@map("drive_documents")
}

model DocumentChunk {
  id            Int       @id @default(autoincrement())
  documentId    Int       @map("document_id")
  driveFileId   String    @map("drive_file_id") @db.VarChar(128)
  policyCode    String    @map("policy_code") @db.VarChar(30)
  title         String    @db.VarChar(200)
  section       String    @db.VarChar(200)
  version       String    @db.VarChar(40)
  effectiveDate String    @default("2026-01-01") @map("effective_date") @db.VarChar(40)
  owner         String    @default("Dirección de Talento y Cultura") @db.VarChar(120)
  driveUrl      String    @map("drive_url") @db.Text
  chunkIndex    Int       @map("chunk_index")
  content       String    @db.Text
  embedding     Json
  createdAt     DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  document DriveDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex], map: "uq_chunk_doc_idx")
  @@index([policyCode], map: "idx_chunks_policy")
  @@map("document_chunks")
}

model DocumentAuditAlert {
  id              Int         @id @default(autoincrement())
  driveFileId     String      @map("drive_file_id") @db.VarChar(128)
  title           String      @db.VarChar(200)
  alertType       String      @map("alert_type") @db.VarChar(40)
  severity        String      @default("media") @db.VarChar(20)
  detail          String      @db.Text
  status          AlertStatus @default(activa)
  occurrenceCount Int         @default(1) @map("occurrence_count")
  resolved        Boolean     @default(false)
  lastSeenAt      DateTime?   @default(now()) @map("last_seen_at") @db.DateTime(0)
  resolvedAt      DateTime?   @map("resolved_at") @db.DateTime(0)
  createdAt       DateTime?   @default(now()) @map("created_at") @db.DateTime(0)

  @@index([driveFileId, alertType, status], map: "idx_alerts_lookup")
  @@map("document_audit_alerts")
}

model ChatConversation {
  id         String    @id @db.VarChar(64)
  employeeId Int       @map("employee_id")
  title      String    @db.VarChar(160)
  createdAt  DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  messages ChatLog[]

  @@index([employeeId, updatedAt], map: "idx_conv_emp_updated")
  @@map("chat_conversations")
}

model ChatLog {
  id            Int         @id @default(autoincrement())
  traceId       String      @map("trace_id") @db.VarChar(64)
  employeeId    Int         @map("employee_id")
  sessionId     String      @map("session_id") @db.VarChar(64)
  question      String      @db.Text
  answer        String      @db.Text
  intent        String      @db.VarChar(40)
  agentUsed     String      @map("agent_used") @db.VarChar(80)
  promptVersion String      @default("1.2.0") @map("prompt_version") @db.VarChar(40)
  topic         String      @db.VarChar(60)
  citationsJson Json        @map("citations_json")
  latencyMs     Int         @map("latency_ms")
  outcome       ChatOutcome
  helpful       Boolean?
  createdAt     DateTime?   @default(now()) @map("created_at") @db.DateTime(0)

  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  conversation ChatConversation? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt], map: "idx_chat_emp_created")
  @@index([outcome, createdAt], map: "idx_chat_outcome_created")
  @@index([traceId], map: "idx_chat_trace")
  @@map("chat_logs")
}

model Ticket {
  id               Int          @id @default(autoincrement())
  folio            String       @unique @db.VarChar(30)
  employeeId       Int          @map("employee_id")
  assigneeId       Int?         @map("assignee_id")
  topic            String       @db.VarChar(120)
  confirmedSummary String       @map("confirmed_summary") @db.Text
  status           TicketStatus @default(abierto)
  assignedTo       String       @map("assigned_to") @db.VarChar(150)
  isSensitive      Boolean      @default(false) @map("is_sensitive")
  createdAt        DateTime?    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime?    @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  employee Employee        @relation("EmployeeTickets", fields: [employeeId], references: [id], onDelete: Cascade)
  assignee Employee?       @relation("AssigneeTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  history  TicketHistory[]

  @@index([employeeId, status], map: "idx_tickets_emp_status")
  @@index([isSensitive, status], map: "idx_tickets_sensitive")
  @@map("tickets")
}

model TicketHistory {
  id        Int       @id @default(autoincrement())
  ticketId  Int       @map("ticket_id")
  actorName String    @map("actor_name") @db.VarChar(150)
  action    String    @db.VarChar(80)
  notes     String    @db.Text
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt], map: "idx_ticket_hist_created")
  @@map("ticket_history")
}

model DailyReport {
  id                           Int       @id @default(autoincrement())
  reportDate                   DateTime  @unique @map("report_date") @db.Date
  absencesToday                Int       @default(0) @map("absences_today")
  pendingRequests              Int       @default(0) @map("pending_requests")
  pendingOver3Days             Int       @default(0) @map("pending_over_3_days")
  activeDisabilities           Int       @default(0) @map("active_disabilities")
  resolvedWithoutEscalationPct Decimal   @default(0.00) @map("resolved_without_escalation_pct") @db.Decimal(5, 2)
  monthlyDisabilityDays        Int       @default(0) @map("monthly_disability_days")
  monthlyHires                 Int       @default(0) @map("monthly_hires")
  monthlyExits                 Int       @default(0) @map("monthly_exits")
  turnoverRatePct              Decimal   @default(0.00) @map("turnover_rate_pct") @db.Decimal(5, 2)
  employeesOver20VacationDays  Int       @default(0) @map("employees_over_20_vacation_days")
  prevDayChatVolume            Int       @default(0) @map("prev_day_chat_volume")
  prevDayAvgLatencyMs          Int       @default(0) @map("prev_day_avg_latency_ms")
  payloadJson                  Json      @map("payload_json")
  executiveSummary             String    @map("executive_summary") @db.Text
  generatedAt                  DateTime? @default(now()) @map("generated_at") @db.DateTime(0)

  @@map("daily_reports")
}
