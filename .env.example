# Entorno y Base de Datos (Node.js + Express + Prisma + MySQL)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=mysql://root:password@127.0.0.1:3306/nubera_rrhh

# Autenticación y Sesión
JWT_SECRET=cambia-esta-clave-secreta-en-produccion-nubera-2026
JWT_EXPIRE_MINUTES=480

# Modelos de IA (none | deepseek | openai | gemini)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=local-384
EMBEDDING_DIM=384

# Google Drive API (sincronización real con Google Drive, PDFs y Google Sheets)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_AUTH_MODE=oauth2
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=token.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Programación de Agentes (America/Mexico_City)
TIMEZONE=America/Mexico_City
ANALYST_CRON_HOUR=7
ANALYST_CRON_MINUTE=0
INGESTION_CRON_HOUR=6
INGESTION_CRON_MINUTE=30
