# Entorno y Base de Datos
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + pgvector (para producción / Docker)
# Si se deja vacío o usa sqlite, el backend arranca en modo demostración local con SQLite + búsqueda vectorial local.
DATABASE_URL=postgresql+psycopg://nubera:nubera_secret@localhost:5432/nubera_rrhh

# Autenticación y Sesión
JWT_SECRET=cambia-esta-clave-secreta-en-produccion-nubera-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Modelos de IA (Opcional: none | deepseek | openai | gemini)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=local-384
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_DIM=384

# Google Drive API (Opcional: para sincronización real con Google Drive y Sheets)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_AUTH_MODE=oauth2
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=token.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Programación de Agentes (America/Mexico_City)
TIMEZONE=America/Mexico_City
ANALYST_CRON_HOUR=7
ANALYST_CRON_MINUTE=0
INGESTION_CRON_HOUR=6
INGESTION_CRON_MINUTE=30
